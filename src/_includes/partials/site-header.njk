{% set bodyClasses = bodyClass or '' %}
{% set isLegalPage = 'legal-page' in bodyClasses %}
<header class="site-header home-header{% if isLegalPage %} legal-home-header{% endif %}">
  <div class="container header-inner">
    <a class="brand" href="{{ '/' | url }}">
      <img src="{{ site.icon | url }}" alt="" aria-hidden="true">
      <span>{{ site.name }}</span>
    </a>
    <button class="mobile-nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M4 7.25h16"></path>
        <path d="M7 12h13"></path>
        <path d="M4 16.75h16"></path>
      </svg>
    </button>
    <nav class="nav{% if isLegalPage %} legal-nav{% endif %}" id="site-nav" aria-label="Main navigation">
      {% include 'partials/main-links.njk' %}
      <a class="nav-button" href="{{ (ctaContent or 'nav') | playUrl }}" target="_blank" rel="noopener">Download now</a>
    </nav>
  </div>
</header>
