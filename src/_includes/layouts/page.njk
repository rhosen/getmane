---
layout: layouts/base.njk
bodyClass: legal-page page-page
---
<div class="blog-shell page-page">
  <div class="page">
    {% set ctaContent = ctaContent or 'page' %}
    {% include 'partials/legal-header.njk' %}

    <main>
      <header class="page-hero">
        <h1 class="page-title">{{ pageHeading or title }}</h1>
        {% if description and showDescription != false %}<p class="page-lead">{{ description }}</p>{% endif %}
      </header>

      <article class="blog-article page-article">
        {{ content | safe }}
      </article>
    </main>

    {% include 'partials/legal-footer.njk' %}
  </div>
</div>
